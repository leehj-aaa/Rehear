  m_text: "\uC624\uB978\uC190 \uCEE8\uD2B8\uB864\uB7EC\uB85C \uAC04\uB2E8\uD55C \uC870\uC791\uC744
    \uB530\uB77C \uD574\uBCF4\uC138\uC694"
