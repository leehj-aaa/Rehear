--- !u!114 &418186965
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 418186963}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC548\uB155\uD558\uC138\uC694. \uBC1C\uD45C\uB97C \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uC624\uB298 \uBC1C\uD45C\uC5D0\uC11C\uB294 \uCC28\uC138\uB300 \uC720\uC804\uC790
    \uD3B8\uC9D1 \uAE30\uC220\uC778 CRISPR-Cas9\uC744 \uD65C\uC6A9\uD55C \uBA74\uC5ED\uD56D\uC554
    \uCE58\uB8CC\uC758 \uCD5C\uC2E0 \uC5F0\uAD6C\uC5D0 \uB300\uD574 \uC18C\uAC1C\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uBA3C\uC800
    \uC5F0\uAD6C \uAC1C\uC694\uC785\uB2C8\uB2E4. \uBA74\uC5ED\uD56D\uC554 \uCE58\uB8CC\uB294
    \uC6B0\uB9AC \uBAB8\uC758 \uBA74\uC5ED\uC138\uD3EC\uAC00 \uC554\uC138\uD3EC\uB97C
    \uC9C1\uC811 \uACF5\uACA9\uD558\uB3C4\uB85D \uB3D5\uB294 \uCE58\uB8CC\uBC95\uC73C\uB85C,
    \uAE30\uC874 \uD56D\uC554\uCE58\uB8CC\uBCF4\uB2E4 \uC815\uC0C1\uC138\uD3EC\uC758
    \uC190\uC0C1\uC744 \uC904\uC77C \uC218 \uC788\uB2E4\uB294 \uC7A5\uC810\uC774
    \uC788\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uCE58\uB8CC \uD6A8\uACFC\uAC00
    \uBAA8\uB4E0 \uD658\uC790\uC5D0\uAC8C \uB3D9\uC77C\uD558\uAC8C \uB098\uD0C0\uB098\uC9C0
    \uC54A\uB294\uB2E4\uB294 \uD55C\uACC4\uAC00 \uC788\uC5B4 \uC774\uB97C \uAC1C\uC120\uD558\uAE30
    \uC704\uD55C \uB2E4\uC591\uD55C \uC5F0\uAD6C\uAC00 \uC9C4\uD589\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB2E4\uC74C\uC73C\uB85C
    \uAE30\uC874 \uD56D\uC554 \uCE58\uB8CC\uC758 \uD55C\uACC4\uC785\uB2C8\uB2E4.
    \uCCAB \uBC88\uC9F8\uB294 \uBA74\uC5ED\uC138\uD3EC\uAC00 \uC554 \uC870\uC9C1
    \uB0B4\uBD80\uAE4C\uC9C0 \uCDA9\uBD84\uD788 \uCE68\uD22C\uD558\uC9C0 \uBABB\uD55C\uB2E4\uB294
    \uC810\uC785\uB2C8\uB2E4. \uB450 \uBC88\uC9F8\uB294 \uC885\uC591 \uBBF8\uC138\uD658\uACBD,
    \uC989 TME\uAC00 \uBA74\uC5ED\uC138\uD3EC\uC758 \uAE30\uB2A5\uC744 \uC5B5\uC81C\uD558\uC5EC
    \uC554\uC138\uD3EC\uAC00 \uBA74\uC5ED \uACF5\uACA9\uC744 \uD53C\uD560 \uC218
    \uC788\uB3C4\uB85D \uB9CC\uB4E0\uB2E4\uB294 \uC810\uC785\uB2C8\uB2E4. \uC774\uB7EC\uD55C
    \uC774\uC720\uB85C \uCE58\uB8CC \uD6A8\uACFC\uAC00 \uAC10\uC18C\uD558\uB294 \uBB38\uC81C\uAC00
    \uBC1C\uC0DD\uD569\uB2C8\uB2E4.\n\n\uC774\uB97C \uD574\uACB0\uD558\uAE30 \uC704\uD574
    \uC81C\uC548\uB41C \uAE30\uC220\uC774 CRISPR-Cas9 \uC720\uC804\uC790 \uD3B8\uC9D1
    \uAE30\uC220\uC785\uB2C8\uB2E4. \uC774 \uAE30\uC220\uC740 \uC6D0\uD558\uB294
    \uC720\uC804\uC790\uB9CC \uC815\uD655\uD558\uAC8C \uD3B8\uC9D1\uD560 \uC218 \uC788\uB294
    \uAE30\uC220\uB85C, \uBCF8 \uC5F0\uAD6C\uC5D0\uC11C\uB294 T\uC138\uD3EC\uC758
    PD-1 \uC720\uC804\uC790\uB97C \uC81C\uAC70\uD558\uB294 \uC804\uB7B5\uC744 \uC0AC\uC6A9\uD588\uC2B5\uB2C8\uB2E4.
    PD-1\uC740 \uBA74\uC5ED\uC138\uD3EC\uC758 \uD65C\uC131\uC744 \uC5B5\uC81C\uD558\uB294
    \uC5ED\uD560\uC744 \uD558\uAE30 \uB54C\uBB38\uC5D0 \uC774\uB97C \uC81C\uAC70\uD558\uBA74
    T\uC138\uD3EC\uAC00 \uB354\uC6B1 \uD65C\uBC1C\uD558\uAC8C \uC554\uC138\uD3EC\uB97C
    \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC5F0\uAD6C \uACB0\uACFC,
    \uC720\uC804\uC790 \uD3B8\uC9D1\uB41C T\uC138\uD3EC\uB294 \uC885\uC591 \uC131\uC7A5\uC744
    \uD6A8\uACFC\uC801\uC73C\uB85C \uC5B5\uC81C\uD588\uC73C\uBA70, \uC2E4\uD5D8 \uB370\uC774\uD130\uC5D0\uC11C\uB294
    \uC554\uC138\uD3EC \uCE68\uD22C\uB825\uC774 \uC57D 30% \uC774\uC0C1 \uD5A5\uC0C1\uB41C
    \uAC83\uC73C\uB85C \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB610\uD55C \uBA74\uC5ED\uC138\uD3EC\uC758
    \uD65C\uC131\uB3C4 \uC9C0\uC18D\uC801\uC73C\uB85C \uC720\uC9C0\uB418\uC5B4 \uAE30\uC874
    \uCE58\uB8CC\uBCF4\uB2E4 \uB354 \uB192\uC740 \uD56D\uC554 \uD6A8\uACFC\uB97C
    \uBCF4\uC600\uC2B5\uB2C8\uB2E4.\n\n\uACB0\uB860\uC801\uC73C\uB85C CRISPR-Cas9\uC744
    \uC774\uC6A9\uD55C \uC720\uC804\uC790 \uD3B8\uC9D1\uC740 \uBA74\uC5ED\uD56D\uC554
    \uCE58\uB8CC\uC758 \uD6A8\uC728\uC744 \uB192\uC77C \uC218 \uC788\uB294 \uB9E4\uC6B0
