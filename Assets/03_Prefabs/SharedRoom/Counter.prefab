--- !u!114 &1131736362736596624
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7890570993605160871}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "[1\uC7A5]\n\uC548\uB155\uD558\uC138\uC694. \uC624\uB298\uC740 \uC720\uD29C\uBE0C,
    \uB137\uD50C\uB9AD\uC2A4, \uC1FC\uD551 \uC571\uC5D0\uC11C \uB9E4\uC77C \uB9C8\uC8FC\uCE58\uB294
    \uAC1C\uC778\uD654 \uCD94\uCC9C \uC54C\uACE0\uB9AC\uC998\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uCD94\uCC9C\uC740 \uC218\uB9CE\uC740 \uC120\uD0DD\uC9C0\uB97C \uBE60\uB974\uAC8C
    \uC815\uB9AC\uD574 \uC8FC\uC9C0\uB9CC, \uB3D9\uC2DC\uC5D0 \uC6B0\uB9AC\uAC00
    \uBE44\uC2B7\uD55C \uCF58\uD150\uCE20\uB9CC \uBC18\uBCF5\uD574\uC11C \uBCF4\uAC8C
    \uB9CC\uB4E4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uC624\uB298\uC758 \uC9C8\uBB38\uC740
    \uAC04\uB2E8\uD569\uB2C8\uB2E4. \uCD94\uCC9C \uC54C\uACE0\uB9AC\uC998\uC740 \uC6B0\uB9AC\uC758
    \uC120\uD0DD\uC744 \uB113\uD600 \uC8FC\uB294 \uB3C4\uAD6C\uC77C\uAE4C\uC694,
    \uC544\uB2C8\uBA74 \uBCF4\uC774\uC9C0 \uC54A\uAC8C \uC81C\uD55C\uD558\uB294 \uC7A5\uCE58\uC77C\uAE4C\uC694?\n\n\n[2\uC7A5]\n\uCD94\uCC9C
    \uC54C\uACE0\uB9AC\uC998\uC740 \uD2B9\uBCC4\uD55C \uAE30\uC220\uCC98\uB7FC \uB4E4\uB9AC\uC9C0\uB9CC
    \uC774\uBBF8 \uC77C\uC0C1 \uAE4A\uC219\uC774 \uB4E4\uC5B4\uC640 \uC788\uC2B5\uB2C8\uB2E4.
    \uC601\uC0C1\uC744 \uD558\uB098 \uBCF4\uBA74 \uB2E4\uC74C \uC601\uC0C1\uC774
    \uC81C\uC2DC\uB418\uACE0, \uC74C\uC545\uC744 \uB4E4\uC73C\uBA74 \uCDE8\uD5A5\uC5D0
    \uB9DE\uB294 \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8\uAC00 \uB9CC\uB4E4\uC5B4\uC9D1\uB2C8\uB2E4.
    \uC1FC\uD551\uBAB0\uC5D0\uC11C\uB294 \uC6B0\uB9AC\uAC00 \uD074\uB9AD\uD558\uAC70\uB098
    \uAD6C\uB9E4\uD55C \uC0C1\uD488\uC744 \uBC14\uD0D5\uC73C\uB85C \uC0C8\uB85C\uC6B4
    \uC0C1\uD488\uC744 \uBCF4\uC5EC \uC90D\uB2C8\uB2E4. \uC989, \uCD94\uCC9C\uC740
    \uB2E8\uC21C\uD788 \uC120\uD0DD\uC744 \uB3D5\uB294 \uAC83\uC744 \uB118\uC5B4
    \uB2E4\uC74C \uD589\uB3D9\uC758 \uC21C\uC11C\uB97C \uC124\uACC4\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\n[3\uC7A5]\n\uCD94\uCC9C
    \uC2DC\uC2A4\uD15C\uC758 \uC791\uB3D9 \uBC29\uC2DD\uC740 \uD06C\uAC8C \uC138
    \uB2E8\uACC4\uB85C \uC774\uD574\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBA3C\uC800
    \uD074\uB9AD, \uAC80\uC0C9, \uC2DC\uCCAD \uC2DC\uAC04\uACFC \uAC19\uC740 \uD589\uB3D9
    \uC2E0\uD638\uB97C \uC218\uC9D1\uD569\uB2C8\uB2E4. \uB2E4\uC74C\uC73C\uB85C \uBE44\uC2B7\uD55C
    \uC0AC\uC6A9\uC790\uB098 \uBE44\uC2B7\uD55C \uCF58\uD150\uCE20\uB97C \uAE30\uC900\uC73C\uB85C
    \uC218\uB9CE\uC740 \uD56D\uBAA9 \uC911 \uD6C4\uBCF4\uB97C \uC881\uD799\uB2C8\uB2E4.
    \uB9C8\uC9C0\uB9C9\uC5D0\uB294 \uC0AC\uC6A9\uC790\uAC00 \uAD00\uC2EC\uC744 \uAC00\uC9C8
    \uAC00\uB2A5\uC131\uACFC \uC11C\uBE44\uC2A4\uC758 \uBAA9\uD45C\uB97C \uD568\uAED8
    \uACE0\uB824\uD574 \uC21C\uC704\uB97C \uC815\uD569\uB2C8\uB2E4. \uC911\uC694\uD55C
    \uC810\uC740 \uCD94\uCC9C \uACB0\uACFC\uAC00 \uC6B0\uB9AC\uC758 \uCDE8\uD5A5\uB9CC
    \uBC18\uC601\uD558\uB294 \uAC83\uC774 \uC544\uB2C8\uB77C \uD50C\uB7AB\uD3FC\uC774
    \uC911\uC694\uD558\uAC8C \uC0DD\uAC01\uD558\uB294 \uBAA9\uD45C\uB3C4 \uBC18\uC601\uD55C\uB2E4\uB294
    \uAC83\uC785\uB2C8\uB2E4.\n\n\n[4\uC7A5]\n\uCD94\uCC9C\uC758 \uAC00\uC7A5 \uD070
    \uC7A5\uC810\uC740 \uD0D0\uC0C9 \uC2DC\uAC04\uC744 \uC904\uC778\uB2E4\uB294 \uAC83\uC785\uB2C8\uB2E4.
    \uC6D0\uD558\uB294 \uCF58\uD150\uCE20\uB97C \uBE60\uB974\uAC8C \uCC3E\uACE0,
    \uBAB0\uB790\uB358 \uCC3D\uC791\uC790\uB098 \uC0C1\uD488\uC744 \uBC1C\uACAC\uD560
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uCD94\uCC9C\uC774
    \uACFC\uAC70 \uD589\uB3D9\uC5D0 \uC9C0\uB098\uCE58\uAC8C \uC758\uC874\uD558\uBA74
    \uBE44\uC2B7\uD55C \uC120\uD0DD\uC774 \uBC18\uBCF5\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB610\uD55C \uB0B4\uAC00 \uC120\uD0DD\uD588\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC9C0\uB9CC
    \uC2E4\uC81C\uB85C\uB294 \uD654\uBA74 \uC0C1\uB2E8\uC5D0 \uB178\uCD9C\uB41C \uD56D\uBAA9\uC744
    \uC120\uD0DD\uD588\uC744 \uAC00\uB2A5\uC131\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uB530\uB77C\uC11C
    \uCD94\uCC9C\uC758 \uD6A8\uACFC\uB294 \uB2E8\uC21C\uD788 \uC88B\uB2E4, \uB098\uC058\uB2E4\uB85C
    \uB098\uB204\uAE30\uBCF4\uB2E4 \uD3B8\uB9AC\uD568\uACFC \uB2E4\uC591\uC131\uC758
    \uADE0\uD615\uC73C\uB85C \uBCF4\uC544\uC57C \uD569\uB2C8\uB2E4.\n\n\n[5\uC7A5]\n\uADF8\uB807\uB2E4\uBA74
    \uCD94\uCC9C\uC744 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC544\uC57C \uD560\uAE4C\uC694?
    \uD604\uC2E4\uC801\uC778 \uD574\uB2F5\uC740 \uCD94\uCC9C\uC744 \uC5C6\uC560\uB294
    \uAC83\uC774 \uC544\uB2C8\uB77C \uC0AC\uC6A9\uC790\uC758 \uD1B5\uC81C\uAD8C\uC744
    \uB192\uC774\uB294 \uAC83\uC785\uB2C8\uB2E4. \uCCAB\uC9F8, \uC65C \uC774 \uCF58\uD150\uCE20\uAC00
    \uCD94\uCC9C\uB410\uB294\uC9C0 \uC774\uD574\uD560 \uC218 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4.
    \uB458\uC9F8, \uAD00\uC2EC \uC5C6\uC74C\uC774\uB098 \uAE30\uB85D \uC0AD\uC81C
    \uAE30\uB2A5\uC744 \uD1B5\uD574 \uCD94\uCC9C\uC744 \uC870\uC815\uD560 \uC218
    \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uC14B\uC9F8, \uAC00\uB054\uC740 \uAC80\uC0C9\uC774\uB098
    \uCE74\uD14C\uACE0\uB9AC\uB97C \uC774\uC6A9\uD574 \uCD94\uCC9C \uC601\uC5ED \uBC16\uC73C\uB85C
    \uC9C1\uC811 \uB098\uAC00 \uBCF4\uB294 \uC2B5\uAD00\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.
    \uD50C\uB7AB\uD3FC \uC5ED\uC2DC \uD074\uB9AD\uB960\uB9CC\uC774 \uC544\uB2C8\uB77C
    \uB2E4\uC591\uC131\uACFC \uC7A5\uAE30\uC801\uC778 \uB9CC\uC871\uB3C4\uB97C \uACE0\uB824\uD574\uC57C
    \uD569\uB2C8\uB2E4.\n\n\n[6\uC7A5]\n\uACB0\uB860\uC801\uC73C\uB85C \uCD94\uCC9C
    \uC54C\uACE0\uB9AC\uC998\uC740 \uC120\uD0DD\uC744 \uB113\uD790 \uC218\uB3C4 \uC788\uACE0
    \uC81C\uD55C\uD560 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uACB0\uACFC\uB97C
    \uACB0\uC815\uD558\uB294 \uAC83\uC740 \uC54C\uACE0\uB9AC\uC998 \uC790\uCCB4\uB9CC\uC774
    \uC544\uB2C8\uB77C \uD50C\uB7AB\uD3FC\uC758 \uBAA9\uD45C\uC640 \uC0AC\uC6A9\uC790\uC758
    \uC774\uC6A9 \uBC29\uC2DD\uC785\uB2C8\uB2E4. \uCD94\uCC9C\uC740 \uBC29\uD5A5\uC744
    \uC81C\uC2DC\uD558\uB294 \uC9C0\uB3C4\uCC98\uB7FC \uD65C\uC6A9\uD558\uB418, \uCD5C\uC885
    \uBAA9\uC801\uC9C0\uB294 \uC2A4\uC2A4\uB85C \uC120\uD0DD\uD574\uC57C \uD569\uB2C8\uB2E4.
    \uC774\uC81C \uC9C8\uBB38\uC744 \uBC1B\uACA0\uC2B5\uB2C8\uB2E4. \uD3B8\uB9AC\uD568\uACFC
    \uB2E4\uC591\uC131 \uC911 \uBB34\uC5C7\uC774 \uB354 \uC911\uC694\uD558\uB2E4\uACE0
    \uC0DD\uAC01\uD558\uC2DC\uB294\uC9C0 \uD568\uAED8 \uC774\uC57C\uAE30\uD574 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.\n\n"
